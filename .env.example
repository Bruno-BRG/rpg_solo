# ─────────────────────────────────────────────────────────────
# RPG Solo — environment template
# Copy to `.env` for local dev; on Coolify set these as env vars.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://rpg:rpg@localhost:5432/rpg_solo?schema=public"

# ── Auth ─────────────────────────────────────────────────────
# Secret used to sign sessions. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# ── AI providers (optional at build time, configured in UI) ──
# OpenAI API key (pay-per-token). Can also be set per-user in Settings.
# OPENAI_API_KEY=

# ChatGPT OAuth (Codex-style, uses ChatGPT Plus subscription limits).
# OAuth client credentials for the ChatGPT/Codex device flow.
# CHATGPT_OAUTH_CLIENT_ID=
# CHATGPT_OAUTH_CLIENT_SECRET=
# CHATGPT_OAUTH_REDIRECT_URI=

# Embeddings model for the RAG pipeline.
# EMBEDDINGS_MODEL="text-embedding-3-small"
