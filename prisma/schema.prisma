// ─────────────────────────────────────────────────────────────
// RPG Solo — Prisma schema
//
// Domain overview:
//   User            — authenticated player (multi-user, credentials auth)
//   Campaign        — a solo campaign workspace (setting, chaos rank, scene)
//   Setting         — campaign setting template / house rules source text
//   Character       — Savage Worlds character sheet (with XP progression)
//   Scene           — a play session scene (oracle rolls, transcript)
//   OracleLog       — every Mythic oracle query, human or AI driven
//   Thread          — open plot thread tracked by the emulator
//   StoryCharacter  — NPCs and story characters (distinct from PCs)
//   JournalEntry    — AI-generated narrative journal of the story
//   ChatTurn        — persisted GM conversation (context memory)
//   DramaticTask    — SWADE dramatic tasks (tokens vs the clock)
//   CustomTable     — user-authored d100 tables
//   LoreChunk       — RAG chunk with pgvector embedding (per campaign)
//   AiSettings      — per-user AI provider configuration
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (Auth.js / NextAuth credentials) ────────────────────

/// Platform user. All game content is owned by a user.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaigns     Campaign[]
  customTables  CustomTable[]
  aiSettings    AiSettings?
  accounts      Account[]
  sessions      Session[]
}

/// Auth.js OAuth account link (future providers).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Auth.js session (only used if database sessions are enabled).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Campaign domain ──────────────────────────────────────────

/// A solo campaign: the top-level workspace tying setting, cast,
/// scenes, journal and RAG lore together.
model Campaign {
  id          String   @id @default(cuid())
  userId      String
  name        String
  /// Short genre/setting descriptor, e.g. "weird west", "space opera".
  genre       String?
  /// Mythic chaos rank: 1 (boring) … 9 (insane). Drives fate chart odds.
  chaosRank   Int      @default(5)
  /// Current scene description shown on the dashboard.
  currentScene String?
  /// Free-form setting notes / rules text also fed into RAG.
  settingNotes String?
  /// Per-campaign AI config (overrides the user's global settings).
  /// Chat model id for GM turns; empty/null = use the user's model.
  chatModel   String?
  /// Conversation style / GM persona override for this campaign.
  gmPersona   String?
  /// Narrative temperature for GM turns (0–2); default 0.8.
  temperature Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters Character[]
  scenes     Scene[]
  threads    Thread[]
  storyChars  StoryCharacter[]
  journal    JournalEntry[]
  chatTurns  ChatTurn[]
  tasks      DramaticTask[]
  loreChunks LoreChunk[]
  facts      CampaignFact[]
  arcs       StoryArc[]
  beats      StoryBeat[]
  clocks     StoryClock[]
  encounters Encounter[]

  @@index([userId])
}

/// Reusable setting template: genre boilerplate, skill lists,
/// house rules — pasteable source text for RAG ingestion.
model Setting {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Raw source text (rules, setting bible, pasted PDF text).
  sourceText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Savage Worlds character sheet (PC or companion).
model Character {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  /// Concept one-liner, e.g. "retired space marine medic".
  concept     String?
  ancestry    String?
  /// Novice | Seasoned | Veteran | Heroic | Legendary
  rank        String   @default("Novice")
  /// Core attributes 1–12 (d4 step = 4 … d12 = 12).
  agility     Int      @default(4)
  smarts      Int      @default(4)
  spirit      Int      @default(4)
  strength    Int      @default(4)
  vigor       Int      @default(4)
  /// Skill map: { "Fighting": 8, "Notice": 4, ... } stored as JSON.
  skills      Json     @default("{}")
  /// Edge names array (JSON).
  edges       Json     @default("[]")
  /// Hindrance names array (JSON).
  hindrances  Json     @default("[]")
  /// Current bennies.
  bennies     Int      @default(3)
  /// Current wounds (0–3) and fatigue (0–2).
  wounds      Int      @default(0)
  fatigue     Int      @default(0)
  /// Shaken status from Savage Worlds; cleared explicitly by the player/GM.
  shaken      Boolean  @default(false)
  /// Experience points (1 advance every 5 XP — see progression.ts).
  xp          Int      @default(0)
  /// Power points for arcane characters.
  powerPoints Int      @default(0)
  /// Free-form gear list.
  gear        String?
  /// Portrait-free visual identity: short description.
  appearance  String?
  /// Backstory text (also ingested into RAG).
  background  String?
  isDead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([campaignId])
}

/// A scene played in the campaign. Holds the transcript and
/// scene-level Mythic state (altered scenes, complications).
model Scene {
  id         String   @id @default(cuid())
  campaignId String
  title      String
  /// Scene type: Set | Altered | Interrupt (Mythic scene setup).
  type       String   @default("Set")
  /// Player-authored intent for the scene.
  goal       String?
  /// Rolling transcript of actions, rolls and narration.
  transcript Json     @default("[]")
  /// Scene complications raised by random events.
  complications Json  @default("[]")
  open       Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign  Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  oracleLogs OracleLog[]

  @@index([campaignId])
}

/// Every oracle consultation (fate chart, random event, detail
/// check…) — whether asked by the human or the AI GM.
model OracleLog {
  id         String   @id @default(cuid())
  sceneId    String
  /// FateChart | RandomEvent | DetailCheck | SceneSetup | CustomTable
  kind       String
  /// The question asked or table context.
  question   String
  /// Mythic likelihood: AlmostCertain … AlmostImpossible
  likelihood String?
  /// Roll inputs and resolved answer, e.g. { rolls:[...], answer:"Yes" }
  result     Json
  /// Who asked: "player" or "ai".
  askedBy    String   @default("player")
  createdAt  DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([sceneId])
}

/// Open plot thread tracked by the Mythic emulator.
model Thread {
  id         String   @id @default(cuid())
  campaignId String
  summary    String
  /// Active | Resolved | Abandoned
  status     String   @default("Active")
  /// Thread complexity/tension 1–3 per Mythic.
  tension    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}

/// Story characters / NPCs (distinct from playable Character sheets).
model StoryCharacter {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  description String?
  /// Per Mythic: Neutral | Friendly | Hostile (can drift).
  stance     String   @default("Neutral")
  /// Alive | Dead | Gone
  status     String   @default("Alive")
  /// What this NPC wants — their own agenda in the story.
  agenda     String?
  /// What they are doing about it right now (the GM's plan for them).
  plan       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  combatants Combatant[]

  @@index([campaignId])
}

/// AI-generated narrative journal — the campaign's running story.
model JournalEntry {
  id         String   @id @default(cuid())
  campaignId String
  sceneId    String?
  /// Chapter/scene number for ordering the timeline.
  order      Int      @default(0)
  title      String
  /// Full narrative entry (markdown).
  body       String
  /// One-paragraph recap used for cheap context injection.
  summary    String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, order])
}

/// A persisted GM conversation turn — the AI's short-term memory
/// and the UI's chat history (survives page reloads).
model ChatTurn {
  id         String   @id @default(cuid())
  campaignId String
  /// "user" | "assistant"
  role       String
  /// complete | failed (partial effects remain when a GM turn fails).
  status     String   @default("complete")
  /// Turn text (narration for the assistant, action for the player).
  content    String
  /// Tool calls executed during an assistant turn (JSON array).
  toolTrace  Json?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

/// SWADE dramatic task: tokens earned vs the round clock.
/// Skills/attempts are stored as JSON mirrors of
/// `lib/rules/dramatic-tasks.ts` structures.
model DramaticTask {
  id         String   @id @default(cuid())
  campaignId String
  sceneId    String?
  name       String
  /// Allowed skills (JSON array of names).
  skills     Json
  /// Target number (default 4).
  targetNumber Int    @default(4)
  /// Tokens required to complete (SWADE default 10).
  requiredSuccesses Int @default(10)
  /// Tokens banked so far.
  successes  Int      @default(0)
  /// Rounds allowed / rounds used.
  timeLimit  Int      @default(4)
  timeUsed   Int      @default(0)
  /// running | completed | failed
  status     String   @default("running")
  /// Attempt log (JSON array of { round, skill, raises, tokens }).
  attempts   Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}

/// User-authored d100 table, reusable across campaigns.
model CustomTable {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  /// Equal-width d100 bands (JSON array of entry strings).
  entries     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Campaign knowledge (facts the GM must never forget) ──────

/// A durable fact established in play. This is the GM's campaign
/// knowledge base: names, places, promises, rulings, mysteries.
/// Facts are injected into every turn, not only retrieved.
model CampaignFact {
  id         String   @id @default(cuid())
  campaignId String
  /// Character | Location | Faction | Item | Event | Promise | Ruling | Mystery
  category   String
  text       String
  /// 1 (colour) … 3 (critical continuity).
  importance Int      @default(2)
  /// Active | Archived (archived facts leave the digest, stay in the record).
  status     String   @default("Active")
  /// GM | Player | Scene — where the fact came from.
  sourceKind String   @default("GM")
  /// Scene that established it, when known.
  sceneId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status, importance])
}

// ── GM preparation (the plan the GM plays toward) ────────────

/// A long-running storyline the GM is preparing toward.
model StoryArc {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  /// One-paragraph setup of the arc.
  premise    String?
  /// What resolving the arc would mean.
  goal       String?
  /// Planned | Active | Resolved | Abandoned
  status     String   @default("Planned")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  beats    StoryBeat[]

  @@index([campaignId, status])
}

/// A prepared upcoming event — the GM's forward plan.
model StoryBeat {
  id         String   @id @default(cuid())
  campaignId String
  arcId      String?
  title      String
  /// How the GM expects it to land, and what it changes.
  detail     String?
  /// Planned | Ready | Done | Skipped
  status     String   @default("Planned")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  arc      StoryArc? @relation(fields: [arcId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
}

/// A tension clock — pressure that builds as the fiction moves.
model StoryClock {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String?
  current     Int      @default(0)
  max         Int      @default(6)
  /// Active | Resolved | Abandoned
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}


// ── Tactical encounters (grid combat) ────────────────────────

/// A tactical encounter fought on a square grid. One active per campaign.
model Encounter {
  id         String   @id @default(cuid())
  campaignId String
  /// Scene this fight belongs to, when it was opened from one.
  sceneId    String?
  name       String
  /// Setup | Active | Ended
  status     String   @default("Setup")
  round      Int      @default(1)
  /// Grid size in squares.
  width      Int      @default(12)
  height     Int      @default(12)
  /// Terrain cells: [{ x, y, kind, label }] where kind is wall | cover | difficult | hazard.
  terrain    Json     @default("[]")
  /// Action Deck left for the next round: [{ rank, suit, joker, label }].
  deck       Json     @default("[]")
  /// Round history: [{ round, order: [{ name, card, joker }] }].
  rounds     Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  combatants Combatant[]
  log        EncounterLog[]

  @@index([campaignId, status])
}

/// One piece on the grid: a player character, a story character or an extra.
model Combatant {
  id               String  @id @default(cuid())
  encounterId      String
  name             String
  /// PlayerCharacter | StoryCharacter | Extra
  kind             String  @default("Extra")
  /// Linked sheet, when this piece is a player character.
  characterId      String?
  /// Linked story character, when this piece is an NPC.
  storyCharacterId String?
  x                Int     @default(0)
  y                Int     @default(0)
  /// Footprint in squares (1 = 1x1).
  size             Int     @default(1)
  pace             Int     @default(6)
  parry            Int     @default(2)
  toughness        Int     @default(4)
  wounds           Int     @default(0)
  maxWounds        Int     @default(3)
  shaken           Boolean @default(false)
  bennies          Int     @default(0)
  /// Extras are taken out by a single wound.
  isExtra          Boolean @default(false)
  /// Defending this round: +2 Parry against melee attacks.
  defending        Boolean @default(false)
  /// Card dealt this round: { rank, suit, joker, label }.
  card             Json?
  /// Active | Down | Out
  status           String  @default("Active")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter      Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character      Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)
  storyCharacter StoryCharacter? @relation(fields: [storyCharacterId], references: [id], onDelete: SetNull)

  @@index([encounterId])
}

/// One line of the combat history, newest last.
model EncounterLog {
  id          String   @id @default(cuid())
  encounterId String
  round       Int      @default(1)
  /// Card | Move | Attack | Damage | Condition | Terrain | Note
  kind        String
  text        String
  data        Json?
  createdAt   DateTime @default(now())

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([encounterId, createdAt])
}

// ── RAG ──────────────────────────────────────────────────────


/// A chunk of campaign knowledge with a pgvector embedding.
/// Vector search happens through raw SQL (Prisma `queryRaw`),
/// since pgvector operations live outside the Prisma type layer.
model LoreChunk {
  id         String   @id @default(cuid())
  campaignId String
  /// Provenance: Journal | Character | SettingNotes | Rules | Scene
  source     String
  sourceId   String?
  /// Ordered position within the source document.
  chunkIndex Int      @default(0)
  content    String
  /// text-embedding-3-small produces 1536 dimensions.
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, source])
}

// ── AI configuration ─────────────────────────────────────────

/// Per-user AI provider configuration.
model AiSettings {
  id             String  @id @default(cuid())
  userId         String  @unique
  /// "openai-api" (API key, pay per token) or
  /// "chatgpt-oauth" (ChatGPT Plus subscription, Codex-style flow).
  provider       String  @default("openai-api")
  /// Chat model identifier, e.g. "gpt-4o", "gpt-6-astra".
  chatModel      String  @default("gpt-4o")
  /// API key stored server-side; never sent to the client.
  apiKey         String?
  /// OAuth tokens for the ChatGPT subscription flow.
  oauthAccessToken  String?
  oauthRefreshToken String?
  oauthExpiresAt    DateTime?
  /// ChatGPT account id (from id_token) — required request header.
  oauthAccountId    String?
  /// GM persona system-prompt override.
  gmPersona     String?
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
