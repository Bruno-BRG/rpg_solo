{
  "name": "rpg-solo",
  "version": "0.1.0",
  "private": true,
  "description": "Solo RPG platform: Savage Worlds rules engine, Mythic GM Emulator oracle, AI Game Master with RAG, journal and campaign workspace.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:rules && npm run test:tools && npm run test:db && npm run test:gm",
    "test:rules": "tsx scripts/smoke-rules.ts",
    "test:tools": "tsx scripts/smoke-tools.ts",
    "test:legacy": "tsx scripts/smoke-test.ts",
    "test:db": "tsx scripts/smoke-db.ts",
    "test:gm": "tsx scripts/smoke-gm.ts",
    "test:api": "tsx scripts/smoke-api.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "next": "^14.2.21",
    "next-auth": "^4.24.10",
    "openai": "^4.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
